# 复制为 .env 并填入真实密钥。.env 已被 .gitignore 排除，绝不提交。

# ---- LLM（DeepSeek / OpenAI 兼容）----
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_FLASH=deepseek-v4-flash   # 检索 Worker / 一般开发
DEEPSEEK_MODEL_PRO=deepseek-v4-pro       # Supervisor/Planner/Reflect

# ---- GitHub ----
GITHUB_TOKEN=ghp_your_github_token        # 需 public_repo scope

# ---- 存储（相对路径会解析到项目根）----
QDRANT_PATH=./data/qdrant
DB_PATH=./data/tdas.db
RAW_DATA_DIR=./data/raw

# ---- 索引 ----
TARGET_REPO=langchain-ai/langchain
DOCS_REPO=langchain-ai/docs              # 官方文档独立仓库
DOCS_PREFIX=src/                         # 文档内容前缀
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2   # 384 维；可换 bge-base-en-v1.5(768)
EMBED_DIM=384

# ---- 网络 ----
HF_ENDPOINT=https://hf-mirror.com        # HuggingFace 国内镜像

# ---- 可观测（LangSmith，可选）----
# 在 smith.langchain.com 注册拿免费 key 后填入，LangGraph 自动图级追踪 + LLM span；
# 留空则静默关闭、不影响运行。
LANGSMITH_API_KEY=
LANGCHAIN_PROJECT=tdas
